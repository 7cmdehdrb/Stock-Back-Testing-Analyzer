# ============================================================
# 포트폴리오 성과 분석기 - 환경변수 설정
# 이 파일을 복사하여 .env 로 저장 후 값을 채워주세요.
# cp .env.example .env
# ============================================================

# ── 필수 ──────────────────────────────────────────────────

# Flask 세션 암호화 키. 반드시 복잡한 랜덤 문자열로 설정하세요.
# 생성 예시 (Linux/Mac): openssl rand -hex 32
# 생성 예시 (Python):    python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=여기에_랜덤_시크릿_키를_입력하세요

# ── 선택 ──────────────────────────────────────────────────

# 호스트에서 접근할 포트 (기본값: 8000)
HOST_PORT=8000

# 타임존 (기본값: Asia/Seoul)
TZ=Asia/Seoul

# 디버그 모드 (운영 환경에서는 반드시 false)
DEBUG=false
